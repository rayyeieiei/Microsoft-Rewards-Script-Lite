        "maxBridgeDirectoryBytes": 52428800,
        "processedRetentionHours": 24,
        "rejectionMetadataRetentionHours": 72,
        "claimingStaleMs": 60000
    },
    "staleEvidenceThresholdHours": 48,
    "shutdownTimeoutMs": 10000
}
