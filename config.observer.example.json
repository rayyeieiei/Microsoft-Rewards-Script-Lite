{
    "contractVersion": 1,
    "identitiesPath": "identities.json",
    "storageDirectory": "data",
    "sessionBasePath": "sessions",
    "dashboard": {
        "enabled": true,
        "host": "127.0.0.1",
        "port": 4100,
        "maxSseClients": 10,
        "sseHeartbeatMs": 15000
    },
    "observationBridge": {
        "enabled": true,
