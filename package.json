{
    "name": "microsoft-rewards-script-lite",
    "version": "3.2.0",
    "description": "Pure HTTP / DAPI engine for Microsoft Rewards tasks in TypeScript",
    "author": "Netsky",
    "license": "GPL-3.0-or-later",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "start": "ts-node src/index.ts",
        "dev": "ts-node src/index.ts -dev",
        "build": "tsc && node scripts/copy-dashboard-assets.cjs",
        "test": "ts-node test/index.test.ts",
        "observer": "node dist/observer.js",
        "observer:ts": "ts-node src/observer.ts",
        "observer:dev": "ts-node src/observer.ts -dev",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "keywords": [
        "Microsoft Rewards",
        "DAPI",
        "HTTP",
        "TypeScript",
        "Automation"
    ],
    "devDependencies": {
        "@types/ms": "^2.1.0",
        "@types/node": "^24.10.1",
        "@types/semver": "^7.7.1",
        "@typescript-eslint/eslint-plugin": "^8.48.0",
        "eslint": "^9.39.1",
        "eslint-plugin-modules-newline": "^0.0.6",
        "prettier": "^3.7.1",
        "rimraf": "^6.1.2",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "axios": "^1.13.5",
        "axios-retry": "^4.5.0",
        "chalk": "^4.1.2",
        "http-proxy-agent": "^7.0.2",
        "https-proxy-agent": "^7.0.6",
        "ms": "^2.1.3",
        "otpauth": "^9.5.0",
        "p-queue": "^9.1.0",
        "semver": "^7.7.4",
        "socks-proxy-agent": "^8.0.5",
        "ts-node": "^10.9.2",
        "zod": "^4.3.6"
    }
}
